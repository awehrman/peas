{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [
    "**/.env.*local"
  ],
  "globalEnv": [
    "NODE_ENV",
    "SIGN_UP_CODES",
    "DATABASE_URL"
  ],
  "globalPassThroughEnv": [
    "QUEUE_AUTH_SECRET",
    "CORS_ALLOWED_ORIGINS",
    "BULL_BOARD_USERNAME",
    "BULL_BOARD_PASSWORD",
    "R2_ACCOUNT_ID",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "R2_BUCKET_NAME",
    "TEST_DATABASE_URL"
  ],
  "tasks": {
    "db:generate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "clean": {
      "cache": false,
      "outputs": []
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".output/**",
        "dist/**",
        "dist-scripts/**",
        "shared-styles.css"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "format": {
      "cache": false
    },
    "test": {
      "cache": false,
      "outputs": [
        "coverage/**"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true,
      "inputs": [
        "packages/components/dist/**"
      ]
    },
    "build-storybook": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "storybook-static/**"
      ],
      "inputs": [
        "packages/components/dist/**"
      ]
    },
    "generate": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "watch": {
      "cache": false,
      "persistent": true
    },
    "test:coverage": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "outputs": [
        "coverage/**"
      ]
    }
  }
}
