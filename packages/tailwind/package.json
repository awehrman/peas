{
  "name": "@peas/tailwind",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./shared-styles.css",
    "./postcss": "./postcss.config.mjs"
  },
  "dependencies": {
    "@peas/theme": "*",
    "@tailwindcss/postcss": "^4.3.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@peas/eslint-config": "*",
    "@peas/typescript-config": "*",
    "@types/node": "^24.0.13",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build:css:compile": "tsup scripts/build-styles.ts --format esm --out-dir dist-scripts",
    "build:css": "yarn build:css:compile && node dist-scripts/build-styles.js",
    "build": "yarn build:css",
    "dev": "yarn build:css:compile && node dist-scripts/build-styles.js --watch"
  }
}
