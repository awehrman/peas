// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

// The connection URL lives in prisma.config.ts (Prisma 7)
datasource db {
  provider = "postgresql"
}


// prisma/schemas/auth.prisma
// Authentication module
// Contains user authentication and session management

enum UserType {
  ADMIN
  USER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  username      String   @unique
  email         String   @unique
  passwordHash  String
  avatarUrl     String?
  sessions Session[]

  userType UserType @default(USER)

  verifiedMentions IngredientMention[]
  decisions        LexiconDecision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id           String   @id
  expiresAt    DateTime
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

// prisma/schemas/notes.prisma
// Notes module
// Contains note processing and status tracking

enum NoteStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DUPLICATE
}

enum ErrorCode {
  HTML_PARSE_ERROR
  INGREDIENT_PARSE_ERROR
  INSTRUCTION_PARSE_ERROR
  QUEUE_JOB_FAILED
  IMAGE_UPLOAD_FAILED
  UNKNOWN_ERROR
}

model EvernoteMetadata {
  id String @id @default(cuid())

  evernoteGUID        String?
  source              String?
  notebook            String?
  tags        String[]
  originalCreatedAt   DateTime?

  evernoteCreatedAt DateTime?
  evernoteUpdatedAt DateTime?

  note Note?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}



model Note {
  id                  String    @id @default(cuid())
  title               String?
  html                String @db.Text // For large HTML content
  status              NoteStatus @default(PENDING)
  importId            String? // Import session identifier for tracking and upserts

  evernoteMetadataId String? @unique
  evernoteMetadata   EvernoteMetadata? @relation(fields: [evernoteMetadataId], references: [id], onDelete: Cascade)
  
  totalIngredientLines Int @default(0)
  totalInstructionLines Int @default(0)
  parsingErrorCount     Int     @default(0)

  parsedIngredientLines ParsedIngredientLine[]
  parsedInstructionLines ParsedInstructionLine[]
  queueJobs QueueJob[]
  statusEvents NoteStatusEvent[]
  images Image[] // Relation to images

  errorMessage String?
  errorCode ErrorCode?
  errorDetails Json?
  duplicateConfidence Float? // Confidence level (0.0 to 1.0) when note is marked as duplicate
  titleSimHash String? // SimHash of the title for similarity comparison

  categories Category[]
  tags       Tag[]
  sources    Source[]

  recipe Recipe?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([titleSimHash]) // Index for SimHash similarity queries
  @@index([importId]) // Index for import tracking and upserts
}

model NoteStatusEvent {
  id String @id @default(cuid())
  
  status NoteStatus
  errorMessage String?
  errorCode ErrorCode?
  errorDetails Json?
  
  // For tracking progress (e.g., "ingredients (1/5) processed")
  currentCount Int?
  totalCount Int?
  
  // Additional context about what was being processed
  context String? // e.g., "ingredient line parsing", "image upload", etc.
  
  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  noteId String
  
  createdAt DateTime @default(now())
  
  @@index([noteId])
  @@index([status])
  @@index([createdAt])
  @@index([noteId, createdAt])  // for filtering by note + time
  @@index([status, createdAt])  // for filtering by status + time
} 

// prisma/schemas/images.prisma
// Images module
// Contains image processing and storage

model Image {
  id String @id @default(cuid())
  
  // Original uploaded image
  originalImageUrl String
  
  // Different aspect ratio crops
  thumbnailImageUrl String? // 1:1 square thumbnail
  crop3x2ImageUrl String? // 3:2 aspect ratio crop
  crop4x3ImageUrl String? // 4:3 aspect ratio crop
  crop16x9ImageUrl String? // 16:9 aspect ratio crop
  
  // Metadata
  originalWidth Int?
  originalHeight Int?
  originalSize Int? // File size in bytes
  originalFormat String? // jpg, png, etc.
  
  // Processing status
  processingStatus String @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  processingError String?
  
  // Relations
  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  noteId String
  importId String? // Import session identifier for tracking and upserts

  recipes Recipe[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([noteId])
  @@index([processingStatus])
  @@index([importId]) // Index for import tracking and upserts
  @@unique([importId]) // Unique constraint for upsert operations
} 

// prisma/schemas/queue.prisma
// Queue module
// Contains background job processing and queue management

enum QueueJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum QueueJobType {
  PROCESS_NOTE
  PROCESS_INGREDIENT_LINE
  PROCESS_INSTRUCTION_LINE
  PROCESS_CATEGORIZATION
}

model QueueJob {
  id String @id @default(cuid())
  
  jobId String @unique
  type QueueJobType
  status QueueJobStatus @default(PENDING)
  
  data Json?
  
  errorMessage String?
  errorCode ErrorCode?
  errorDetails Json?
  retryCount Int @default(0)
  maxRetries Int @default(3)
  
  startedAt DateTime?
  completedAt DateTime?
  
  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  noteId String
  
  // Only one of these should be set based on job type
  ingredientLine ParsedIngredientLine? @relation(fields: [ingredientLineId], references: [id])
  ingredientLineId String?
  
  instructionLine ParsedInstructionLine? @relation(fields: [instructionLineId], references: [id])
  instructionLineId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([noteId])
  @@index([status])
  @@index([type])
} 

// prisma/schemas/parsing.prisma
enum ParseStatus {
  AWAITING_PARSING
  COMPLETED_WITH_ERROR
  COMPLETED_SUCCESSFULLY
}

enum ReviewStatus {
  UNREVIEWED
  CORRECT
  INCORRECT
}

// Parsing module
// Contains parsed content from recipe notes

model ParsedIngredientLine {
  id String @id @default(cuid())

  blockIndex Int
  lineIndex  Int
  reference  String
  rule       String?

  parseStatus ParseStatus @default(AWAITING_PARSING)
  reviewStatus ReviewStatus @default(UNREVIEWED)
  parsedAt              DateTime?
  parsed                ParsedSegment[]
  queueJobs QueueJob[]

  ingredientReferences IngredientReference[]

  // v2 ingredient mentions (one per parsed segment)
  mentions IngredientMention[]

  // New field to mark lines as active/inactive
  isActive Boolean @default(true)

  // Which parser produced the segments: "static_v1" or "grammar:<versionId>"
  parserVersion String?

  Note   Note?   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  noteId String?

  // Link to the unique line pattern
  uniqueLinePattern   UniqueLinePattern? @relation(fields: [uniqueLinePatternId], references: [id])
  uniqueLinePatternId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([noteId])
  @@index([isActive])
  @@index([uniqueLinePatternId])
  @@unique([noteId, blockIndex, lineIndex])
}

model ParsedInstructionLine {
  id String @id @default(cuid())

  lineIndex Int
  originalText String
  normalizedText String?

  parseStatus ParseStatus @default(AWAITING_PARSING)
  reviewStatus ReviewStatus @default(UNREVIEWED)

  isActive Boolean @default(true)

  note   Note?   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  noteId String?
  queueJobs QueueJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([noteId])
  @@index([isActive])
}

model ParsingRule {
  id String @id @default(cuid())

  // "#1_ingredientLine >> #3_ingredients >> #2_ingredientExpression >> #2_ingredient"
  name String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Related parsed segments
  parsedSegments ParsedSegment[]

  @@index([name])
}

model ParsedSegment {
  id String @id @default(cuid())

  index Int
  rule  String
  type  String
  value String
  processingTime Int? // Processing time in milliseconds

  ingredientLine   ParsedIngredientLine @relation(fields: [ingredientLineId], references: [id], onDelete: Cascade)
  ingredientLineId String

  // Reference to the parsing rule
  parsingRule   ParsingRule? @relation(fields: [ruleId], references: [id])
  ruleId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ingredientLineId])
  @@index([ruleId])
}

model UniqueLinePattern {
  id String @id @default(cuid())

  // Array of parsing rule IDs in order
  ruleIds String[]

  // Example line that matches this pattern
  exampleLine String?

  // Count of times this pattern has been seen
  occurrenceCount Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Related parsed ingredient lines
  parsedIngredientLines ParsedIngredientLine[]

  @@unique([ruleIds])
  @@index([occurrenceCount])
} 


// prisma/schemas/meta.prisma
// Meta module
// Contains categorization and tagging

model Category {
  id String @id @default(cuid())

  name String

  notes   Note[]
  recipes Recipe[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag {
  id String @id @default(cuid())

  name String

  notes   Note[]
  recipes Recipe[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


// prisma/schemas/source.prisma
// Source module
// Contains source tracking and references

model Source {
  id String @id @default(cuid())

  // URLs associated with this source
  urls URL[]
  
  // Book information (optional)
  book Book? @relation(fields: [bookId], references: [id])
  bookId String?

  // Notes that reference this source
  notes Note[]

  // Recipes promoted from those notes
  recipes Recipe[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Website {
  id String @id @default(cuid())

  siteName String?
  domainName String?
  
  // URLs associated with this website
  urls URL[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([domainName])
  @@index([siteName])
}

model URL {
  id String @id @default(cuid())

  author String?
  url String
  lastAccessed DateTime?
  isBrokenLink Boolean @default(false)

  // Website this URL belongs to
  website Website? @relation(fields: [websiteId], references: [id])
  websiteId String?

  // Source this URL belongs to
  source Source @relation(fields: [sourceId], references: [id])
  sourceId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([url])
  @@index([lastAccessed])
  @@index([isBrokenLink])
}

model Book {
  id String @id @default(cuid())

  title String
  author String?
  publisher String?
  publicationDate DateTime?
  isbn String?

  sources Source[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
} 

// prisma/schemas/ingredients.prisma
model Ingredient {
  id               String               @id @default(cuid())
  name             String
  plural           String?
  isReviewed       Boolean              @default(false)
  reviewedAt       DateTime?
  isComposedIngredient Boolean           @default(false) // Indicates if this ingredient can also be a recipe

  // Alias names (e.g. "Granny Smith")
  aliases          Alias[]

  // Tag-style properties (e.g. dairy, nut, vegan, etc.)
  properties       IngredientProperty[]

  // Optional substitutions (self-relations)
  substitutions    Ingredient[]         @relation("Substitutions")
  substitutedBy    Ingredient[]         @relation("Substitutions")

  // Variant system (self-relation to parent ingredient)
  variants         Ingredient[]         @relation("Variants")
  parentIngredient Ingredient?          @relation("Variants", fields: [parentIngredientId], references: [id])
  parentIngredientId String?

  isChildVariant   Boolean              @default(false) // true if this is a variant of another

  // Category (e.g. "fruit", "meat")
  categoryId       String?
  category         IngredientCategory?  @relation(fields: [categoryId], references: [id])

  // Tags (flexible labeling like "low-carb", "breakfast")
  tags             IngredientTag[]

  // References to where this ingredient was found
  references       IngredientReference[]

  // Brands (many-to-many)
  brands           Brand[]              @relation("IngredientBrands")

  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

model Alias {
  id           String     @id @default(cuid())
  name         String
  plural       String?
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  ingredientId String
}

model IngredientProperty {
  id            String        @id @default(cuid())
  ingredient    Ingredient    @relation(fields: [ingredientId], references: [id])
  ingredientId  String
  propertyType  PropertyType
}

// Track where ingredients are found in parsed lines
model IngredientReference {
  id                String      @id @default(cuid())
  
  // The ingredient that was found
  ingredient        Ingredient  @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  ingredientId      String
  
  // The parsed line where it was found
  parsedLine        ParsedIngredientLine @relation(fields: [parsedLineId], references: [id], onDelete: Cascade)
  parsedLineId      String
  
  // The segment within the line where it was found
  segmentIndex      Int         // Index within the parsed segments
  
  // Context from the original line
  reference         String      // The full original text (e.g., "2 cups flour")
  noteId            String?     // Optional link to the note
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@unique([ingredientId, parsedLineId, segmentIndex])
  @@index([ingredientId])
  @@index([parsedLineId])
  @@index([noteId])
}

enum PropertyType {
  // Dietary
  VEGAN
  VEGETARIAN
  GLUTEN_FREE

  // Core types
  MEAT
  FISH
  DAIRY
  EGG
  GRAIN
  LEGUME
  FRUIT
  VEGETABLE
  HERB
  SPICE

  // Allergens
  NUTS
  SHELLFISH
  SOY
  SESAME
  CORN
  ALCOHOL
}

model IngredientCategory {
  id          String       @id @default(cuid())
  name        String
  ingredients Ingredient[]
}

model IngredientTag {
  id           String       @id @default(cuid())
  name         String       @unique
  ingredients  Ingredient[] // Many-to-many relation
  concepts     FoodConcept[]
}

model Brand {
  id          String        @id @default(cuid())
  name        String        @unique
  ingredients Ingredient[] @relation("IngredientBrands")
  products    FoodProduct[]
}


// prisma/schemas/recipes.prisma
// Recipes module
// A recipe is a curated note: it keeps the note as provenance and reuses
// the note's parsed ingredient and instruction lines.

model Recipe {
  id String @id @default(cuid())

  title String

  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  noteId String @unique

  image   Image?  @relation(fields: [imageId], references: [id], onDelete: SetNull)
  imageId String?

  categories Category[]
  tags       Tag[]
  sources    Source[]

  /// Food concepts that this recipe makes, e.g. a "garam masala" recipe (FoodConcept.isComposed).
  composedConcepts FoodConcept[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([title])
}


// prisma/schemas/ontology.prisma
// Food ontology, lexicon, and ingredient mentions (v2 parser, Phase 2).
//
// Ids are time-ordered UUIDs (v7) stored as native uuid columns. Columns that
// point at legacy tables (Recipe, Brand, IngredientTag, ParsedIngredientLine,
// User) stay text because those tables use cuid ids.
//
// The migration adds constraints Prisma cannot express (pg_trgm index, CHECK
// constraints, a partial index). `prisma db push` would drop them; always use
// migrations. Enum value lists are mirrored in @peas/parser/v2 (ontology/types.ts,
// knowledge/schemas.ts) and checked by the database tests.

enum ConceptStatus {
  PROPOSED
  VERIFIED
  DEPRECATED
}

enum EntryStatus {
  PROPOSED
  ACTIVE
  DEPRECATED
}

enum LexiconRole {
  FOOD
  ATTRIBUTE
  PREPARATION
  DEGREE
  MEASUREMENT_MODIFIER
  INSTRUCTION
}

enum LexiconTermKind {
  CANONICAL
  ALIAS
  PLURAL
  REGIONAL
  ABBREVIATION
  VARIANT
}

enum FoodRelationshipType {
  IS_A
  PART_OF
  DERIVED_FROM
  PROCESSED_FROM
}

enum AttributeValueType {
  ENUM
  NUMBER
  BOOLEAN
  TEXT
}

enum ClassificationKind {
  FOOD_GROUP
  DIETARY
  ALLERGEN
  CATEGORY
  CERTIFICATION
}

enum TriState {
  TRUE
  FALSE
  UNKNOWN
}

enum ValueSource {
  LEGACY
  MANUAL
  ASSERTED
  INFERRED
}

enum ResolutionStatus {
  UNRESOLVED
  AUTO_RESOLVED
  NEEDS_REVIEW
  VERIFIED
}

enum ParseMode {
  CONSERVATIVE
  EXPLORATORY
}

enum PrepPosition {
  PRE_HEAD
  POST_HEAD
}

enum DiscoveryType {
  UNKNOWN_FOOD_PHRASE
  UNKNOWN_MODIFIER
  ATTRIBUTE_INTERPRETATION
  IDENTITY_DECISION
  AMBIGUOUS_MATCH
  RELATIONSHIP_SUGGESTION
  STRUCTURAL_PATTERN
  VERIFIED_DRIFT
}

enum DiscoveryStatus {
  OPEN
  DEFERRED
  RESOLVED
  REJECTED
}

enum DecisionType {
  MAP_TO_CONCEPT
  CREATE_CONCEPT
  CONCEPT_PLUS_ATTRIBUTE
  CLASSIFY_MODIFIER
  ADD_ATTRIBUTE_VALUE
  ADD_RELATIONSHIP
  MARK_AMBIGUOUS
  IGNORE_TOKEN
  REJECT
  MERGE_CONCEPTS
  CORRECT_MENTION
  REVERT
}

enum LegacyMappingStatus {
  PENDING
  MAPPED
  NEEDS_REVIEW
  SKIPPED
}

/// A food identity, e.g. "chicken thigh" or "granny smith apple". Names live in LexiconEntry rows.
model FoodConcept {
  id               String        @id @default(uuid(7)) @db.Uuid
  canonicalName    String
  slug             String        @unique
  status           ConceptStatus @default(PROPOSED)
  description      String?
  isComposed       Boolean       @default(false)
  composedRecipe   Recipe?       @relation(fields: [composedRecipeId], references: [id], onDelete: SetNull)
  composedRecipeId String?
  /// Set when the concept is deprecated by a merge.
  mergedInto       FoodConcept?  @relation("ConceptMergedInto", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedIntoId     String?       @db.Uuid
  mergedFrom       FoodConcept[] @relation("ConceptMergedInto")

  entries           LexiconEntry[]
  outgoing          FoodRelationship[]        @relation("RelationshipSource")
  incoming          FoodRelationship[]        @relation("RelationshipTarget")
  attributes        ConceptAttribute[]
  applicability     AttributeApplicability[]
  classifications   FoodClassification[]
  substitutionsFrom FoodSubstitution[]        @relation("SubstituteFrom")
  substitutionsTo   FoodSubstitution[]        @relation("SubstituteTo")
  products          FoodProduct[]
  tags              IngredientTag[]
  mentions          IngredientMention[]
  survivorMerges    ConceptMergeRecord[]      @relation("MergeSurvivor")
  mergedMerges      ConceptMergeRecord[]      @relation("MergeMerged")
  legacyMappings    LegacyIngredientMapping[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([canonicalName])
}

/// One known expression and the role it plays, e.g. "chicken thighs" (FOOD, PLURAL of chicken thigh) or "finely" (DEGREE, valueKey fine).
model LexiconEntry {
  id                 String                @id @default(uuid(7)) @db.Uuid
  /// Original casing and punctuation.
  text               String
  /// normalizeText(text).text from @peas/parser/v2.
  normalized         String
  /// entryMatchKey(text): lowercased tokens joined by spaces; what the parser compares.
  matchKey           String
  tokenCount         Int
  role               LexiconRole
  /// FOOD entries only.
  kind               LexiconTermKind?
  locale             String?
  status             EntryStatus           @default(PROPOSED)
  concept            FoodConcept?          @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  conceptId          String?               @db.Uuid
  attributeValue     AttributeValue?       @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)
  attributeValueId   String?               @db.Uuid
  preparation        PreparationOperation? @relation(fields: [preparationId], references: [id], onDelete: Cascade)
  preparationId      String?               @db.Uuid
  /// DEGREE, MEASUREMENT_MODIFIER, and INSTRUCTION targets, e.g. "fine", "packed", "divided".
  valueKey           String?
  /// food:<conceptId>, attr:<attributeValueId>, prep:<preparationId>, or <role>:<valueKey> (decision D4).
  targetKey          String
  normalizerVersion  String
  revisionAddedRef   LexiconRevision       @relation("EntryRevisionAdded", fields: [revisionAdded], references: [id])
  revisionAdded      Int
  revisionRetiredRef LexiconRevision?      @relation("EntryRevisionRetired", fields: [revisionRetired], references: [id])
  revisionRetired    Int?
  decision           LexiconDecision?      @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  decisionId         String?               @db.Uuid

  mentionAttributes MentionAttribute[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchKey, targetKey])
  @@index([matchKey])
  @@index([status, role])
  @@index([conceptId])
}

/// An attribute dimension, e.g. bone, color, fat_content.
model AttributeDefinition {
  id            String                   @id @default(uuid(7)) @db.Uuid
  key           String                   @unique
  name          String
  valueType     AttributeValueType       @default(ENUM)
  values        AttributeValue[]
  applicability AttributeApplicability[]
}

/// One value of a dimension, e.g. bone=boneless.
model AttributeValue {
  id           String              @id @default(uuid(7)) @db.Uuid
  definition   AttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  definitionId String              @db.Uuid
  key          String
  label        String

  entries           LexiconEntry[]
  conceptAttributes ConceptAttribute[]
  mentionAttributes MentionAttribute[]

  @@unique([definitionId, key])
}

/// The dimension applies to this concept and its IS_A / PART_OF descendants.
model AttributeApplicability {
  definition   AttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  definitionId String              @db.Uuid
  concept      FoodConcept         @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  conceptId    String              @db.Uuid

  @@id([definitionId, conceptId])
}

/// Attributes that characterize the concept itself, e.g. buttermilk has fat_content=low.
model ConceptAttribute {
  concept          FoodConcept    @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  conceptId        String         @db.Uuid
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)
  attributeValueId String         @db.Uuid
  source           ValueSource    @default(MANUAL)

  @@id([conceptId, attributeValueId])
}

/// A preparation operation, e.g. mince, dice, sift.
model PreparationOperation {
  id    String @id @default(uuid(7)) @db.Uuid
  key   String @unique
  label String

  entries      LexiconEntry[]
  preparations MentionPreparation[]
}

/// Directed edge from the more specific concept (source) to the more general or originating one (target).
model FoodRelationship {
  id         String               @id @default(uuid(7)) @db.Uuid
  source     FoodConcept          @relation("RelationshipSource", fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId   String               @db.Uuid
  target     FoodConcept          @relation("RelationshipTarget", fields: [targetId], references: [id], onDelete: Cascade)
  targetId   String               @db.Uuid
  type       FoodRelationshipType
  status     EntryStatus          @default(PROPOSED)
  decision   LexiconDecision?     @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  decisionId String?              @db.Uuid
  createdAt  DateTime             @default(now())

  @@unique([sourceId, targetId, type])
  @@index([targetId, type])
}

/// An explicit classification, e.g. DAIRY TRUE or ALLERGEN_PEANUT FALSE. Inherited values are computed at read time.
model FoodClassification {
  id        String             @id @default(uuid(7)) @db.Uuid
  concept   FoodConcept        @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  conceptId String             @db.Uuid
  kind      ClassificationKind
  /// DAIRY, GLUTEN_FREE, ALLERGEN_PEANUT, CATEGORY:<name>
  key       String
  value     TriState           @default(UNKNOWN)
  source    ValueSource        @default(MANUAL)
  note      String?

  @@unique([conceptId, key])
  @@index([key, value])
}

/// A contextual substitution, kept out of FoodRelationship on purpose.
model FoodSubstitution {
  id            String      @id @default(uuid(7)) @db.Uuid
  fromConcept   FoodConcept @relation("SubstituteFrom", fields: [fromConceptId], references: [id], onDelete: Cascade)
  fromConceptId String      @db.Uuid
  toConcept     FoodConcept @relation("SubstituteTo", fields: [toConceptId], references: [id], onDelete: Cascade)
  toConceptId   String      @db.Uuid
  /// "1:1", "3/4 cup per cup"
  ratio         String?
  note          String?

  @@unique([fromConceptId, toConceptId])
}

/// A branded product, e.g. "Kerrygold" butter.
model FoodProduct {
  id        String       @id @default(uuid(7)) @db.Uuid
  name      String
  brand     Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)
  brandId   String?
  concept   FoodConcept? @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  conceptId String?      @db.Uuid

  @@unique([brandId, name])
}

/// One ingredient mention: a segment of a parsed line, its syntax, and how it resolved.
model IngredientMention {
  id                String               @id @default(uuid(7)) @db.Uuid
  parsedLine        ParsedIngredientLine @relation(fields: [parsedLineId], references: [id], onDelete: Cascade)
  parsedLineId      String
  segmentIndex      Int
  /// Segment text from the raw line.
  rawText           String
  normalizedText    String
  spanStart         Int
  spanEnd           Int
  /// IngredientSegmentSyntax plus line context (Zod-validated).
  syntax            Json
  /// Quantity (Zod-validated), denormalized for queries.
  quantity          Json?
  concept           FoodConcept?         @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  conceptId         String?              @db.Uuid
  /// Resolution (Zod-validated): ranked candidates, reasons, unresolved spans.
  resolution        Json
  resolutionStatus  ResolutionStatus     @default(UNRESOLVED)
  score             Float?
  mode              ParseMode            @default(CONSERVATIVE)
  parserVersion     String
  normalizerVersion String
  resolverVersion   String
  lexiconRevision   Int
  verifiedAt        DateTime?
  verifiedBy        User?                @relation(fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedById      String?

  attributes   MentionAttribute[]
  preparations MentionPreparation[]
  modifiers    MentionModifier[]
  evidence     DiscoveryEvidence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parsedLineId, segmentIndex])
  /// Trigram index for preview prefiltering (decision D20); needs the pg_trgm extension created in the migration.
  @@index([normalizedText(ops: raw("gin_trgm_ops"))], type: Gin, map: "ingredient_mention_normalized_trgm")
  @@index([conceptId])
  @@index([resolutionStatus])
  @@index([lexiconRevision])
  @@index([parserVersion])
}

model MentionAttribute {
  mention          IngredientMention @relation(fields: [mentionId], references: [id], onDelete: Cascade)
  mentionId        String            @db.Uuid
  attributeValue   AttributeValue    @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)
  attributeValueId String            @db.Uuid
  lexiconEntry     LexiconEntry?     @relation(fields: [lexiconEntryId], references: [id], onDelete: SetNull)
  lexiconEntryId   String?           @db.Uuid
  /// ASSERTED (in the text), INFERRED, or MANUAL.
  source           ValueSource
  spanStart        Int?
  spanEnd          Int?

  @@id([mentionId, attributeValueId])
}

model MentionPreparation {
  mention       IngredientMention    @relation(fields: [mentionId], references: [id], onDelete: Cascade)
  mentionId     String               @db.Uuid
  order         Int
  preparation   PreparationOperation @relation(fields: [preparationId], references: [id], onDelete: Cascade)
  preparationId String               @db.Uuid
  degreeKey     String?
  position      PrepPosition
  spanStart     Int
  spanEnd       Int

  @@id([mentionId, order])
}

/// MEASUREMENT_MODIFIER and INSTRUCTION values on a mention.
model MentionModifier {
  mention   IngredientMention @relation(fields: [mentionId], references: [id], onDelete: Cascade)
  mentionId String            @db.Uuid
  order     Int
  role      LexiconRole
  valueKey  String
  spanStart Int
  spanEnd   Int

  @@id([mentionId, order])
}

/// Something the review queue should look at, deduplicated by (type, key).
model Discovery {
  id                   String              @id @default(uuid(7)) @db.Uuid
  type                 DiscoveryType
  /// Normalized phrase, bigram, or structural signature.
  key                  String
  /// DiscoveryPayload (Zod discriminated union by type).
  payload              Json
  status               DiscoveryStatus     @default(OPEN)
  mentionCount         Int                 @default(0)
  distinctNoteCount    Int                 @default(0)
  priority             Float               @default(0)
  firstSeenRevision    Int
  lastSeenRevision     Int
  resolvedByDecision   LexiconDecision?    @relation("DiscoveryResolvedBy", fields: [resolvedByDecisionId], references: [id], onDelete: SetNull)
  resolvedByDecisionId String?             @db.Uuid
  evidence             DiscoveryEvidence[]
  decisions            LexiconDecision[]   @relation("DecisionDiscovery")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, key])
  @@index([status, priority])
}

model DiscoveryEvidence {
  discovery   Discovery         @relation(fields: [discoveryId], references: [id], onDelete: Cascade)
  discoveryId String            @db.Uuid
  mention     IngredientMention @relation(fields: [mentionId], references: [id], onDelete: Cascade)
  mentionId   String            @db.Uuid
  /// Denormalized for distinct-note counts.
  noteId      String?
  spanStart   Int
  spanEnd     Int

  @@id([discoveryId, mentionId])
  @@index([mentionId])
}

/// A reviewed knowledge change. Every decision gets its own revision.
model LexiconDecision {
  id           String           @id @default(uuid(7)) @db.Uuid
  type         DecisionType
  /// DecisionPayload (Zod discriminated union by type).
  payload      Json
  /// DecisionEffects: ids created, updated, or deprecated; used by REVERT.
  effects      Json
  discovery    Discovery?       @relation("DecisionDiscovery", fields: [discoveryId], references: [id], onDelete: SetNull)
  discoveryId  String?          @db.Uuid
  user         User             @relation(fields: [userId], references: [id])
  userId       String
  revisionRef  LexiconRevision  @relation(fields: [revision], references: [id])
  revision     Int              @unique
  revertedBy   LexiconDecision? @relation("DecisionRevertedBy", fields: [revertedById], references: [id], onDelete: SetNull)
  revertedById String?          @unique @db.Uuid
  reverts      LexiconDecision? @relation("DecisionRevertedBy")

  entries             LexiconEntry[]
  relationships       FoodRelationship[]
  resolvedDiscoveries Discovery[]          @relation("DiscoveryResolvedBy")
  merges              ConceptMergeRecord[]

  createdAt DateTime @default(now())
}

/// Monotonic knowledge version. Rows are only inserted, never updated.
model LexiconRevision {
  id        Int      @id @default(autoincrement())
  /// "decision:<id>", "seed:<name>", "legacy-import"
  reason    String
  createdAt DateTime @default(now())

  entriesAdded   LexiconEntry[]   @relation("EntryRevisionAdded")
  entriesRetired LexiconEntry[]   @relation("EntryRevisionRetired")
  decision       LexiconDecision?
}

model ConceptMergeRecord {
  id         String          @id @default(uuid(7)) @db.Uuid
  survivor   FoodConcept     @relation("MergeSurvivor", fields: [survivorId], references: [id], onDelete: Cascade)
  survivorId String          @db.Uuid
  merged     FoodConcept     @relation("MergeMerged", fields: [mergedId], references: [id], onDelete: Cascade)
  mergedId   String          @db.Uuid
  decision   LexiconDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  decisionId String          @db.Uuid
  /// The merged concept's entries, relationships, and classifications before the merge.
  snapshot   Json
  createdAt  DateTime        @default(now())
}

/// Where a legacy Ingredient row went. legacyIngredientId is plain text so it survives the Phase 7 drop.
model LegacyIngredientMapping {
  legacyIngredientId String              @id
  concept            FoodConcept?        @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  conceptId          String?             @db.Uuid
  status             LegacyMappingStatus @default(PENDING)
  note               String?
  migratedAt         DateTime?
}

