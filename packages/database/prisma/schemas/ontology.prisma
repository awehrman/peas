// Food ontology, lexicon, and ingredient mentions (v2 parser, Phase 2).
//
// Ids are time-ordered UUIDs (v7) stored as native uuid columns. Columns that
// point at legacy tables (Recipe, Brand, IngredientTag, ParsedIngredientLine,
// User) stay text because those tables use cuid ids.
//
// The migration adds constraints Prisma cannot express (pg_trgm index, CHECK
// constraints, a partial index). `prisma db push` would drop them; always use
// migrations. Enum value lists are mirrored in @peas/parser/v2 (ontology/types.ts,
// knowledge/schemas.ts) and checked by the database tests.

enum ConceptStatus {
  PROPOSED
  VERIFIED
  DEPRECATED
}

enum EntryStatus {
  PROPOSED
  ACTIVE
  DEPRECATED
}

enum LexiconRole {
  FOOD
  ATTRIBUTE
  PREPARATION
  DEGREE
  MEASUREMENT_MODIFIER
  INSTRUCTION
}

enum LexiconTermKind {
  CANONICAL
  ALIAS
  PLURAL
  REGIONAL
  ABBREVIATION
  VARIANT
}

enum FoodRelationshipType {
  IS_A
  PART_OF
  DERIVED_FROM
  PROCESSED_FROM
}

enum AttributeValueType {
  ENUM
  NUMBER
  BOOLEAN
  TEXT
}

enum ClassificationKind {
  FOOD_GROUP
  DIETARY
  ALLERGEN
  CATEGORY
  CERTIFICATION
}

enum TriState {
  TRUE
  FALSE
  UNKNOWN
}

enum ValueSource {
  LEGACY
  MANUAL
  ASSERTED
  INFERRED
}

enum ResolutionStatus {
  UNRESOLVED
  AUTO_RESOLVED
  NEEDS_REVIEW
  VERIFIED
}

enum ParseMode {
  CONSERVATIVE
  EXPLORATORY
}

enum PrepPosition {
  PRE_HEAD
  POST_HEAD
}

enum DiscoveryType {
  UNKNOWN_FOOD_PHRASE
  UNKNOWN_MODIFIER
  ATTRIBUTE_INTERPRETATION
  IDENTITY_DECISION
  AMBIGUOUS_MATCH
  RELATIONSHIP_SUGGESTION
  STRUCTURAL_PATTERN
  VERIFIED_DRIFT
}

enum DiscoveryStatus {
  OPEN
  DEFERRED
  RESOLVED
  REJECTED
}

enum DecisionType {
  MAP_TO_CONCEPT
  CREATE_CONCEPT
  CONCEPT_PLUS_ATTRIBUTE
  CLASSIFY_MODIFIER
  ADD_ATTRIBUTE_VALUE
  ADD_RELATIONSHIP
  MARK_AMBIGUOUS
  IGNORE_TOKEN
  REJECT
  MERGE_CONCEPTS
  CORRECT_MENTION
  APPROVE_CONCEPT
  EDIT_CONCEPT
  EDIT_ENTRY
  REVERT
}

enum LegacyMappingStatus {
  PENDING
  MAPPED
  NEEDS_REVIEW
  SKIPPED
}

/// A food identity, e.g. "chicken thigh" or "granny smith apple". Names live in LexiconEntry rows.
model FoodConcept {
  id               String        @id @default(uuid(7)) @db.Uuid
  canonicalName    String
  slug             String        @unique
  status           ConceptStatus @default(PROPOSED)
  description      String?
  isComposed       Boolean       @default(false)
  composedRecipe   Recipe?       @relation(fields: [composedRecipeId], references: [id], onDelete: SetNull)
  composedRecipeId String?
  /// Set when the concept is deprecated by a merge.
  mergedInto       FoodConcept?  @relation("ConceptMergedInto", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedIntoId     String?       @db.Uuid
  mergedFrom       FoodConcept[] @relation("ConceptMergedInto")

  entries           LexiconEntry[]
  outgoing          FoodRelationship[]        @relation("RelationshipSource")
  incoming          FoodRelationship[]        @relation("RelationshipTarget")
  attributes        ConceptAttribute[]
  applicability     AttributeApplicability[]
  classifications   FoodClassification[]
  substitutionsFrom FoodSubstitution[]        @relation("SubstituteFrom")
  substitutionsTo   FoodSubstitution[]        @relation("SubstituteTo")
  products          FoodProduct[]
  tags              IngredientTag[]
  mentions          IngredientMention[]
  survivorMerges    ConceptMergeRecord[]      @relation("MergeSurvivor")
  mergedMerges      ConceptMergeRecord[]      @relation("MergeMerged")
  legacyMappings    LegacyIngredientMapping[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([canonicalName])
}

/// One known expression and the role it plays, e.g. "chicken thighs" (FOOD, PLURAL of chicken thigh) or "finely" (DEGREE, valueKey fine).
model LexiconEntry {
  id                 String                @id @default(uuid(7)) @db.Uuid
  /// Original casing and punctuation.
  text               String
  /// normalizeText(text).text from @peas/parser/v2.
  normalized         String
  /// entryMatchKey(text): lowercased tokens joined by spaces; what the parser compares.
  matchKey           String
  tokenCount         Int
  role               LexiconRole
  /// FOOD entries only.
  kind               LexiconTermKind?
  locale             String?
  status             EntryStatus           @default(PROPOSED)
  concept            FoodConcept?          @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  conceptId          String?               @db.Uuid
  attributeValue     AttributeValue?       @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)
  attributeValueId   String?               @db.Uuid
  preparation        PreparationOperation? @relation(fields: [preparationId], references: [id], onDelete: Cascade)
  preparationId      String?               @db.Uuid
  /// DEGREE, MEASUREMENT_MODIFIER, and INSTRUCTION targets, e.g. "fine", "packed", "divided".
  valueKey           String?
  /// food:<conceptId>, attr:<attributeValueId>, prep:<preparationId>, or <role>:<valueKey> (decision D4).
  targetKey          String
  normalizerVersion  String
  revisionAddedRef   LexiconRevision       @relation("EntryRevisionAdded", fields: [revisionAdded], references: [id])
  revisionAdded      Int
  revisionRetiredRef LexiconRevision?      @relation("EntryRevisionRetired", fields: [revisionRetired], references: [id])
  revisionRetired    Int?
  decision           LexiconDecision?      @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  decisionId         String?               @db.Uuid

  mentionAttributes MentionAttribute[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchKey, targetKey])
  @@index([matchKey])
  @@index([status, role])
  @@index([conceptId])
}

/// An attribute dimension, e.g. bone, color, fat_content.
model AttributeDefinition {
  id            String                   @id @default(uuid(7)) @db.Uuid
  key           String                   @unique
  name          String
  valueType     AttributeValueType       @default(ENUM)
  values        AttributeValue[]
  applicability AttributeApplicability[]
}

/// One value of a dimension, e.g. bone=boneless.
model AttributeValue {
  id           String              @id @default(uuid(7)) @db.Uuid
  definition   AttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  definitionId String              @db.Uuid
  key          String
  label        String

  entries           LexiconEntry[]
  conceptAttributes ConceptAttribute[]
  mentionAttributes MentionAttribute[]

  @@unique([definitionId, key])
}

/// The dimension applies to this concept and its IS_A / PART_OF descendants.
model AttributeApplicability {
  definition   AttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  definitionId String              @db.Uuid
  concept      FoodConcept         @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  conceptId    String              @db.Uuid

  @@id([definitionId, conceptId])
}

/// Attributes that characterize the concept itself, e.g. buttermilk has fat_content=low.
model ConceptAttribute {
  concept          FoodConcept    @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  conceptId        String         @db.Uuid
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)
  attributeValueId String         @db.Uuid
  source           ValueSource    @default(MANUAL)

  @@id([conceptId, attributeValueId])
}

/// A preparation operation, e.g. mince, dice, sift.
model PreparationOperation {
  id    String @id @default(uuid(7)) @db.Uuid
  key   String @unique
  label String

  entries      LexiconEntry[]
  preparations MentionPreparation[]
}

/// Directed edge from the more specific concept (source) to the more general or originating one (target).
model FoodRelationship {
  id         String               @id @default(uuid(7)) @db.Uuid
  source     FoodConcept          @relation("RelationshipSource", fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId   String               @db.Uuid
  target     FoodConcept          @relation("RelationshipTarget", fields: [targetId], references: [id], onDelete: Cascade)
  targetId   String               @db.Uuid
  type       FoodRelationshipType
  status     EntryStatus          @default(PROPOSED)
  decision   LexiconDecision?     @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  decisionId String?              @db.Uuid
  createdAt  DateTime             @default(now())

  @@unique([sourceId, targetId, type])
  @@index([targetId, type])
}

/// An explicit classification, e.g. DAIRY TRUE or ALLERGEN_PEANUT FALSE. Inherited values are computed at read time.
model FoodClassification {
  id        String             @id @default(uuid(7)) @db.Uuid
  concept   FoodConcept        @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  conceptId String             @db.Uuid
  kind      ClassificationKind
  /// DAIRY, GLUTEN_FREE, ALLERGEN_PEANUT, CATEGORY:<name>
  key       String
  value     TriState           @default(UNKNOWN)
  source    ValueSource        @default(MANUAL)
  note      String?

  @@unique([conceptId, key])
  @@index([key, value])
}

/// A contextual substitution, kept out of FoodRelationship on purpose.
model FoodSubstitution {
  id            String      @id @default(uuid(7)) @db.Uuid
  fromConcept   FoodConcept @relation("SubstituteFrom", fields: [fromConceptId], references: [id], onDelete: Cascade)
  fromConceptId String      @db.Uuid
  toConcept     FoodConcept @relation("SubstituteTo", fields: [toConceptId], references: [id], onDelete: Cascade)
  toConceptId   String      @db.Uuid
  /// "1:1", "3/4 cup per cup"
  ratio         String?
  note          String?

  @@unique([fromConceptId, toConceptId])
}

/// A branded product, e.g. "Kerrygold" butter.
model FoodProduct {
  id        String       @id @default(uuid(7)) @db.Uuid
  name      String
  brand     Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)
  brandId   String?
  concept   FoodConcept? @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  conceptId String?      @db.Uuid

  @@unique([brandId, name])
}

/// One ingredient mention: a segment of a parsed line, its syntax, and how it resolved.
model IngredientMention {
  id                String               @id @default(uuid(7)) @db.Uuid
  parsedLine        ParsedIngredientLine @relation(fields: [parsedLineId], references: [id], onDelete: Cascade)
  parsedLineId      String
  segmentIndex      Int
  /// 0 unless "and" split the segment into several foods ("salt and pepper": salt is part 0, pepper part 1).
  partIndex         Int                  @default(0)
  /// Segment (or part) text from the raw line.
  rawText           String
  normalizedText    String
  spanStart         Int
  spanEnd           Int
  /// IngredientSegmentSyntax plus line context (Zod-validated).
  syntax            Json
  /// Quantity (Zod-validated), denormalized for queries.
  quantity          Json?
  concept           FoodConcept?         @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  conceptId         String?              @db.Uuid
  /// Resolution (Zod-validated): ranked candidates, reasons, unresolved spans.
  resolution        Json
  resolutionStatus  ResolutionStatus     @default(UNRESOLVED)
  score             Float?
  mode              ParseMode            @default(CONSERVATIVE)
  parserVersion     String
  normalizerVersion String
  resolverVersion   String
  lexiconRevision   Int
  verifiedAt        DateTime?
  verifiedBy        User?                @relation(fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedById      String?

  attributes   MentionAttribute[]
  preparations MentionPreparation[]
  modifiers    MentionModifier[]
  evidence     DiscoveryEvidence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parsedLineId, segmentIndex, partIndex])
  /// Trigram index for preview prefiltering (decision D20); needs the pg_trgm extension created in the migration.
  @@index([normalizedText(ops: raw("gin_trgm_ops"))], type: Gin, map: "ingredient_mention_normalized_trgm")
  @@index([conceptId])
  @@index([resolutionStatus])
  @@index([lexiconRevision])
  @@index([parserVersion])
}

model MentionAttribute {
  mention          IngredientMention @relation(fields: [mentionId], references: [id], onDelete: Cascade)
  mentionId        String            @db.Uuid
  attributeValue   AttributeValue    @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)
  attributeValueId String            @db.Uuid
  lexiconEntry     LexiconEntry?     @relation(fields: [lexiconEntryId], references: [id], onDelete: SetNull)
  lexiconEntryId   String?           @db.Uuid
  /// ASSERTED (in the text), INFERRED, or MANUAL.
  source           ValueSource
  spanStart        Int?
  spanEnd          Int?

  @@id([mentionId, attributeValueId])
}

model MentionPreparation {
  mention       IngredientMention    @relation(fields: [mentionId], references: [id], onDelete: Cascade)
  mentionId     String               @db.Uuid
  order         Int
  preparation   PreparationOperation @relation(fields: [preparationId], references: [id], onDelete: Cascade)
  preparationId String               @db.Uuid
  degreeKey     String?
  position      PrepPosition
  spanStart     Int
  spanEnd       Int

  @@id([mentionId, order])
}

/// MEASUREMENT_MODIFIER and INSTRUCTION values on a mention.
model MentionModifier {
  mention   IngredientMention @relation(fields: [mentionId], references: [id], onDelete: Cascade)
  mentionId String            @db.Uuid
  order     Int
  role      LexiconRole
  valueKey  String
  spanStart Int
  spanEnd   Int

  @@id([mentionId, order])
}

/// Something the review queue should look at, deduplicated by (type, key).
model Discovery {
  id                   String              @id @default(uuid(7)) @db.Uuid
  type                 DiscoveryType
  /// Normalized phrase, bigram, or structural signature.
  key                  String
  /// DiscoveryPayload (Zod discriminated union by type).
  payload              Json
  status               DiscoveryStatus     @default(OPEN)
  mentionCount         Int                 @default(0)
  distinctNoteCount    Int                 @default(0)
  priority             Float               @default(0)
  firstSeenRevision    Int
  lastSeenRevision     Int
  resolvedByDecision   LexiconDecision?    @relation("DiscoveryResolvedBy", fields: [resolvedByDecisionId], references: [id], onDelete: SetNull)
  resolvedByDecisionId String?             @db.Uuid
  evidence             DiscoveryEvidence[]
  decisions            LexiconDecision[]   @relation("DecisionDiscovery")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, key])
  @@index([status, priority])
}

model DiscoveryEvidence {
  discovery   Discovery         @relation(fields: [discoveryId], references: [id], onDelete: Cascade)
  discoveryId String            @db.Uuid
  mention     IngredientMention @relation(fields: [mentionId], references: [id], onDelete: Cascade)
  mentionId   String            @db.Uuid
  /// Denormalized for distinct-note counts.
  noteId      String?
  spanStart   Int
  spanEnd     Int

  @@id([discoveryId, mentionId])
  @@index([mentionId])
}

/// A reviewed knowledge change. Every decision gets its own revision.
model LexiconDecision {
  id           String           @id @default(uuid(7)) @db.Uuid
  type         DecisionType
  /// DecisionPayload (Zod discriminated union by type).
  payload      Json
  /// DecisionEffects: ids created, updated, or deprecated; used by REVERT.
  effects      Json
  discovery    Discovery?       @relation("DecisionDiscovery", fields: [discoveryId], references: [id], onDelete: SetNull)
  discoveryId  String?          @db.Uuid
  user         User             @relation(fields: [userId], references: [id])
  userId       String
  revisionRef  LexiconRevision  @relation(fields: [revision], references: [id])
  revision     Int              @unique
  revertedBy   LexiconDecision? @relation("DecisionRevertedBy", fields: [revertedById], references: [id], onDelete: SetNull)
  revertedById String?          @unique @db.Uuid
  reverts      LexiconDecision? @relation("DecisionRevertedBy")

  entries             LexiconEntry[]
  relationships       FoodRelationship[]
  resolvedDiscoveries Discovery[]          @relation("DiscoveryResolvedBy")
  merges              ConceptMergeRecord[]
  /// Mentions whose reading this decision changed, in the request and in background reinterpretation; the health page's "taught to fixed".
  mentionsChanged     Int                  @default(0)

  createdAt DateTime @default(now())
}

/// Monotonic knowledge version. Rows are only inserted, never updated.
model LexiconRevision {
  id        Int      @id @default(autoincrement())
  /// "decision:<id>", "seed:<name>", "legacy-import"
  reason    String
  createdAt DateTime @default(now())

  entriesAdded   LexiconEntry[]   @relation("EntryRevisionAdded")
  entriesRetired LexiconEntry[]   @relation("EntryRevisionRetired")
  decision       LexiconDecision?
}

model ConceptMergeRecord {
  id         String          @id @default(uuid(7)) @db.Uuid
  survivor   FoodConcept     @relation("MergeSurvivor", fields: [survivorId], references: [id], onDelete: Cascade)
  survivorId String          @db.Uuid
  merged     FoodConcept     @relation("MergeMerged", fields: [mergedId], references: [id], onDelete: Cascade)
  mergedId   String          @db.Uuid
  decision   LexiconDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  decisionId String          @db.Uuid
  /// The merged concept's entries, relationships, and classifications before the merge.
  snapshot   Json
  createdAt  DateTime        @default(now())
}

/// Where a legacy Ingredient row went. legacyIngredientId is plain text so it survives the Phase 7 drop.
model LegacyIngredientMapping {
  legacyIngredientId String              @id
  concept            FoodConcept?        @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  conceptId          String?             @db.Uuid
  status             LegacyMappingStatus @default(PENDING)
  note               String?
  migratedAt         DateTime?
}

enum ReinterpretKind {
  /// Lines a lexicon decision can affect, re-resolved at a newer revision.
  REINTERPRET_BY_REVISION
  /// Lines parsed by another parser version (Phase 6 grammar changes).
  REPARSE_BY_VERSION
}

/// One background reinterpretation (Phase 5). The reinterpret worker fans it out into batch jobs and counts progress here; the web app polls it through Query.job.
model ReinterpretRun {
  id             String          @id @default(uuid(7)) @db.Uuid
  /// Shared with the BullMQ jobs, e.g. "reinterpret-15" (batches are "reinterpret-15-3").
  jobId          String          @unique
  kind           ReinterpretKind
  revision       Int?
  parserVersion  String?
  /// { phrases: string[], conceptIds: string[] } for REINTERPRET_BY_REVISION.
  scope          Json?
  status         QueueJobStatus  @default(PENDING)
  totalLines     Int             @default(0)
  processedLines Int             @default(0)
  batchCount     Int             @default(0)
  completedBatches Int           @default(0)
  failedBatches  Int             @default(0)
  errorMessage   String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status])
}

/// A point-in-time copy of the corpus health numbers, for trends on /teach/health. Written by the daily snapshot job and after every reinterpretation or reparse run.
model CorpusHealthSnapshot {
  id                    String   @id @default(uuid(7)) @db.Uuid
  takenAt               DateTime @default(now())
  /// SCHEDULED, REINTERPRET, REPARSE, or MANUAL.
  trigger               String
  parserVersion         String
  lexiconRevision       Int
  totalLines            Int
  totalMentions         Int
  /// { AUTO_RESOLVED: n, NEEDS_REVIEW: n, UNRESOLVED: n, VERIFIED: n }
  byResolutionStatus    Json
  /// { COMPLETED_SUCCESSFULLY: n, COMPLETED_WITH_ERROR: n, AWAITING_PARSING: n }
  byParseStatus         Json
  /// { "2.1.0": { total: n, unresolved: n } }
  byParserVersion       Json
  /// { UNKNOWN_FOOD_PHRASE: n, STRUCTURAL_PATTERN: n, ... }
  openDiscoveriesByType Json
  verifiedCount         Int
  avgCandidates         Float

  @@index([takenAt])
}
