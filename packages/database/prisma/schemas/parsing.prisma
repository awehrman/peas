enum ParseStatus {
  AWAITING_PARSING
  COMPLETED_WITH_ERROR
  COMPLETED_SUCCESSFULLY
}

enum ReviewStatus {
  UNREVIEWED
  CORRECT
  INCORRECT
}

// Parsing module
// Contains parsed content from recipe notes

model ParsedIngredientLine {
  id String @id @default(cuid())

  blockIndex Int
  lineIndex  Int
  reference  String

  parseStatus ParseStatus @default(AWAITING_PARSING)
  reviewStatus ReviewStatus @default(UNREVIEWED)
  parsedAt              DateTime?
  queueJobs QueueJob[]

  // Ingredient mentions (one per parsed segment, or per part of a segment split on "and")
  mentions IngredientMention[]

  // New field to mark lines as active/inactive
  isActive Boolean @default(true)

  // The parser that produced the mentions, e.g. "v2:2.3.0"
  parserVersion String?

  Note   Note?   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  noteId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([noteId])
  @@index([isActive])
  @@unique([noteId, blockIndex, lineIndex])
}

model ParsedInstructionLine {
  id String @id @default(cuid())

  lineIndex Int
  originalText String
  normalizedText String?

  parseStatus ParseStatus @default(AWAITING_PARSING)
  reviewStatus ReviewStatus @default(UNREVIEWED)

  isActive Boolean @default(true)

  note   Note?   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  noteId String?
  queueJobs QueueJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([noteId])
  @@index([isActive])
}
