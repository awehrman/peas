enum ParseStatus {
  AWAITING_PARSING
  COMPLETED_WITH_ERROR
  COMPLETED_SUCCESSFULLY
}

enum ReviewStatus {
  UNREVIEWED
  CORRECT
  INCORRECT
}

/// What a stored line is after structure review (Phase 8.5). The importer files INGREDIENT and INSTRUCTION; a reviewer can mark a line as a heading, a note, or other text, or record that it moved to the other list (the original row is kept inactive with the kind it moved to).
enum LineKind {
  INGREDIENT
  INSTRUCTION
  SECTION_HEADING
  NOTE
  OTHER
}

// Parsing module
// Contains parsed content from recipe notes

model ParsedIngredientLine {
  id String @id @default(cuid())

  blockIndex Int
  lineIndex  Int
  reference  String

  parseStatus ParseStatus @default(AWAITING_PARSING)
  reviewStatus ReviewStatus @default(UNREVIEWED)
  parsedAt              DateTime?
  queueJobs QueueJob[]

  // Ingredient mentions (one per parsed segment, or per part of a segment split on "and")
  mentions IngredientMention[]

  // New field to mark lines as active/inactive
  isActive Boolean @default(true)

  // The parser that produced the mentions, e.g. "v2:2.3.0"
  parserVersion String?

  /// Position in the extracted note content (Note.html split on newlines, blank lines included).
  contentIndex Int?
  /// The en-note child element the line came from ("div", "p", "li"), for new imports.
  elementTag   String?
  lineKind     LineKind @default(INGREDIENT)

  Note   Note?   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  noteId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([noteId])
  @@index([isActive])
  @@unique([noteId, blockIndex, lineIndex])
}

model ParsedInstructionLine {
  id String @id @default(cuid())

  lineIndex Int
  originalText String
  normalizedText String?

  parseStatus ParseStatus @default(AWAITING_PARSING)
  reviewStatus ReviewStatus @default(UNREVIEWED)

  isActive Boolean @default(true)

  /// Position in the extracted note content (Note.html split on newlines, blank lines included).
  contentIndex Int?
  /// The en-note child element the line came from, for new imports.
  elementTag   String?
  lineKind     LineKind @default(INSTRUCTION)

  note   Note?   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  noteId String?
  queueJobs QueueJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([noteId])
  @@index([isActive])
}
