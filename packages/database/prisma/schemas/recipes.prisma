// Recipes module
// A recipe is a curated note: it keeps the note as provenance and reuses
// the note's parsed ingredient and instruction lines.

model Recipe {
  id String @id @default(cuid())

  title String

  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  noteId String @unique

  image   Image?  @relation(fields: [imageId], references: [id], onDelete: SetNull)
  imageId String?

  categories Category[]
  tags       Tag[]
  sources    Source[]

  /// Food concepts that this recipe makes, e.g. a "garam masala" recipe (FoodConcept.isComposed).
  composedConcepts FoodConcept[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([title])
}
