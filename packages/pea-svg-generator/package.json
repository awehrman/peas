{
  "name": "@peas/pea-svg-generator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm,cjs --dts --no-splitting",
    "dev": "tsup src/index.ts --format esm --watch --dts",
    "lint": "eslint . --max-warnings 0",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "generate": "node dist/cli.js",
    "generate:blobs": "node dist/cli.js blobs",
    "generate:readme": "tsx scripts/readme-peas.ts"
  },
  "devDependencies": {
    "@peas/eslint-config": "*",
    "@peas/typescript-config": "*",
    "@types/node": "^24.0.13",
    "tsup": "^9.0.0",
    "tsx": "^4.7.0",
    "typescript": "^6.0.3"
  }
}
