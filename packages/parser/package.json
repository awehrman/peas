{
  "name": "@peas/parser",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./v1": {
      "types": "./types/index.d.ts",
      "default": "./dist/v1/index.js"
    },
    "./v1/minified": {
      "types": "./types/index.d.ts",
      "default": "./dist/v1/index.min.js"
    },
    "./v3": {
      "types": "./dist/v3/index.d.ts",
      "default": "./dist/v3/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.js",
    "build:v1": "peggy -o dist/v1/parser.js --format es src/v1/parser.peggy && node -e \"require('fs').writeFileSync('dist/v1/index.js', 'export { parse } from \\'./parser.js\\';')\"",
    "generate:v3": "node scripts/generate-v3.js",
    "build:v3": "yarn generate:v3 && tsc -p tsconfig.build.json",
    "typecheck": "yarn generate:v3 && tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest",
    "test:run": "vitest run",
    "corpus:baseline-v1": "node scripts/baseline-v1.js",
    "report:compare": "tsx scripts/compare-v1-v3.ts",
    "preview:lexicon": "tsx scripts/preview-lexicon-change.ts"
  },
  "dependencies": {
    "peggy": "^5.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@peas/typescript-config": "*",
    "@types/node": "^24.0.13",
    "terser": "^5.43.1",
    "tsx": "^4.7.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
