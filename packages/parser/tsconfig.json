{
  "extends": "@peas/typescript-config/base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["es2022"],
    "types": ["node"]
  },
  "include": ["src/v3/**/*.ts"],
  "exclude": ["node_modules", "dist", "legacy"]
}
