# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/mydb?sslmode=require"

# Sign-up Code Configuration
# Uncomment and modify one of these options:

# Option 1: Single code (recommended for simple setups)
SIGN_UP_CODES=code1

# Option 2: Multiple codes (comma-separated)
# SIGN_UP_CODES=code1,code2,code3

# Option 3: Advanced JSON configuration with limits and expiration
# SIGN_UP_CODES='[{"code":"invite123","maxUses":10},{"code":"beta2024","expiresAt":"2024-12-31T23:59:59Z"}]'

REDISHOST=127.0.0.1
REDISPORT=6379
REDISUSER=
REDISPASSWORD=
PORT=4200
FILE_DIRECTORY=public/files

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

FORCE_RESET_MEMORY_CACHE=false

# Shared by web (signs tokens) and queue (verifies them). Must be 32+ characters
# and identical in both services. Generate one with: openssl rand -base64 48
QUEUE_AUTH_SECRET=

# Comma-separated browser origins allowed to call the queue (defaults to localhost)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Bull Board is only mounted when a password is set
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=

# Upload service configuration
NEXT_PUBLIC_UPLOAD_ENDPOINT=http://localhost:4200/upload
