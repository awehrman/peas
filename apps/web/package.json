{
  "name": "@peas/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Peas web app on TanStack Start, GraphQL (Apollo Server 5 in @peas/api), and Apollo Client 4.",
  "scripts": {
    "dev": "PORT=3100 vite dev --port 3100 --strictPort",
    "build": "vite build",
    "start": "PORT=${PORT:-3100} node .output/server/index.mjs",
    "codegen": "graphql-codegen --config codegen.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@apollo/client": "^4.3.8",
    "@apollo/client-integration-tanstack-start": "0.14.5-rc.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@peas/api": "*",
    "@peas/components": "*",
    "@peas/features": "*",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "@tanstack/router-core": "1.171.39",
    "graphql": "^16.15.0",
    "lucide-react": "^0.525.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.0.0",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/fragment-matcher": "^8.0.0",
    "@graphql-codegen/typed-document-node": "^8.0.0",
    "@graphql-codegen/typescript-operations": "^7.0.1",
    "@peas/eslint-config": "*",
    "@peas/tailwind": "*",
    "@peas/typescript-config": "*",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "nitro": "3.0.261103-rc",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
