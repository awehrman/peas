{
  "name": "@peas/queue",
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:reset": "FORCE_RESET_MEMORY_CACHE=true tsx watch src/index.ts",
    "dev:clean": "FORCE_RESET_MEMORY_CACHE=true tsx watch src/index.ts",
    "start": "ts-node dist/index.js",
    "start:reset": "FORCE_RESET_MEMORY_CACHE=true ts-node dist/index.js",
    "build": "tsc --noEmit && tsup src/index.ts --format esm --dts --clean",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint --ext .ts,.tsx src",
    "type-check": "tsc --noEmit",
    "cleanup:imports": "node scripts/cleanup-orphaned-imports.js",
    "preview-export": "tsx scripts/preview-export.ts",
    "clear-imports": "tsx scripts/clear-imports.ts",
    "backfill:mentions": "tsx scripts/backfill-mentions.ts",
    "reinterpret": "tsx scripts/reinterpret.ts",
    "reparse": "tsx scripts/reparse.ts",
    "reparse:dry-run": "tsx scripts/reparse-dry-run.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1167.0",
    "@aws-sdk/s3-request-presigner": "^3.1167.0",
    "@bull-board/api": "^6.11.0",
    "@bull-board/express": "^6.11.0",
    "@peas/database": "*",
    "@peas/parser": "*",
    "@types/find-up": "^4.0.2",
    "@types/sharp": "^0.32.0",
    "bullmq": "^5.56.4",
    "cheerio": "^1.1.0",
    "colors": "^1.4.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "find-up": "^7.0.0",
    "multer": "^2.0.2",
    "pluralize": "^8.0.0",
    "redis": "^5.6.0",
    "sharp": "^0.34.3",
    "simhash-js": "^1.0.0",
    "ts-node": "^10.9.2",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@peas/database": "*",
    "@peas/eslint-config": "*",
    "@peas/typescript-config": "*",
    "@types/cors": "^2.8.13",
    "@types/express": "4",
    "@types/multer": "1",
    "@types/pluralize": "^0.0.33",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.5.10",
    "@vitest/coverage-istanbul": "5.1.0",
    "@vitest/ui": "^5.1.0",
    "eslint": "^9.0.0",
    "supertest": "^7.1.4",
    "ts-node-dev": "^2.0.0",
    "tsup": "^9.0.0",
    "tsx": "^4.7.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
